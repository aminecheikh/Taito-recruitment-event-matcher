# AI provider: google | anthropic | openai | mock (default: mock)
AI_PROVIDER=
# Model id for the chosen provider. Fill the current id from the provider's docs:
#   google    -> a Gemini model id (ai.google.dev/gemini-api/docs/models)
#   anthropic -> a Claude model id (docs.claude.com, models overview)
#   openai    -> a GPT model id (platform.openai.com/docs/models)
AI_MODEL=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Local JSON store. Leave commented to use the default, data/runtime/db.json
# DB_PATH=
# Per-minute cap on AI calls (default: 10)
AI_RATE_LIMIT_PER_MINUTE=
# Per-call timeout for the AI provider in ms, after which the example is shown (default: 8000)
AI_TIMEOUT_MS=
# Cap on AI calls per minute across all visitors (default: 60)
AI_GLOBAL_RATE_LIMIT_PER_MINUTE=
# Set to false on a hosted copy to hide "Reset demo data" (default: true)
DEMO_RESET_ENABLED=
