# Copy to .env (gitignored) and fill in only the key you use: cp .env.example .env
# Names only in this file. Real values go in .env, never in git or in chat with an agent.
# Read by lib/ai/provider.ts (see docs/superpowers/specs/2026-11-14-mvp-design.md › AI layer).

# Which AI provider the app calls: mock | google | anthropic | openai
# mock = scripted outputs, no key, works offline. Use it for UI work and tests.
AI_PROVIDER=mock

# Model id for the chosen provider. Leave empty for mock. Check ids against provider docs on the day.
#   google:    gemini-4-hydrogen  (default real provider: largest credit budget. Google's default
#              general-purpose model, fast. If suggestLinks reasons are weak, try gemini-4-argon)
#   anthropic: claude-opus-5-5    ($20 budget: prompt comparison and maybe the live demo)
#   openai:    gpt-5.6-sol        (only if the team's credits are API credits, not Codex-only)
AI_MODEL=

# API keys: fill only the provider(s) you use. Set spending caps in each provider console.
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
